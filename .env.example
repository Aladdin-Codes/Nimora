# Public values, safe to expose in the browser
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never import into client code.
SUPABASE_SERVICE_ROLE_KEY=

# Development-only seed configuration. Set a private password locally; never commit it.
SEED_TEST_PASSWORD=
SEED_ENVIRONMENT=development
# For a remote development project only, set both values explicitly:
# SEED_ALLOW_REMOTE_DEV=true
# SEED_ALLOWED_PROJECT_REF=your-non-production-project-ref
